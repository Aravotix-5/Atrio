{
  "name": "atrio",
  "version": "1.0.0",
  "private": true,
  "description": "Atrio - custom software and web development platform: service catalog, project builder, quotes, and Stripe payments.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0 <23"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "setup": "npm run migrate && npm run seed",
    "test:smoke": "node tests/smoke.mjs",
    "test:pages": "bash tests/pages.sh"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^9.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "pg": "^8.13.1",
    "stripe": "^17.5.0"
  }
}
